xcuserdata
.SourceryCache
.build
.swiftpm
/Packages
.netrc
.DS_Store
/Package.resolved
# The plugin lane's fixtures resolve this package on every run. Their job is to
# exercise the plugin, not to pin a dependency graph — and an unpinned resolve is
# what a consumer does.
Tests/Checks/PluginFixture/Package.resolved
Tests/Checks/PluginFixtureRed/*/Package.resolved
# The Xcode lane generates its projects from a committed `xcodegen.yml` on every
# run and never commits them: the spec is what a reviewer reads, and the
# project.pbxproj it produces is generated identifiers.
Tests/Checks/XcodeFixture/*.xcodeproj
Tests/Checks/XcodeFixtureRed/*/*.xcodeproj
# The by-URL example is generated the same way, by its own build.sh.
Tests/Examples/ExampleProjectXcode/*.xcodeproj
