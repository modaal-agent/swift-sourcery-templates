<%# ================================================== SwiftLint -%><%_ -%>
<%_ if let rules = argument["excludedSwiftLintRules"] as? [String] { -%>
    <%_ for rule in rules { -%>
    <%_ %>//swiftlint:disable <%= rule %>
    <%_ } -%>
<%_ } -%>

<%# ================================================== IMPORTS -%><%_ -%>
<%_
func generateAdditionalImports(_ types: [Type]) {
  let additionalImports = Set(types.flatMap { $0.annotations(for: AnnotationRegistry.importModule) })
  // A module the configured imports name, or one an `if` value guards, is already imported.
  let existingImports = Set(extractImports().map { CompilationConditions.ImportItem($0).module })
    .union(types.flatMap { CompilationConditions.importedModules(of: $0) })
  let missingImports = additionalImports.subtracting(existingImports).sorted()
  guard !missingImports.isEmpty else { return }
  print(missingImports.map { "import \($0)" }.joined(separator: "\n"))
}

func extractImports(attributeName: String = "import") -> [String] {
  if let imported = argument[attributeName] as? String {
    return [imported]
  } else if let allimported = argument[attributeName] as? [String] {
    return allimported
  } else {
    return []
  }
}

// `importSelectors` is declared by the entry point, above its `include("_header")`: the selectors of
// the protocols it generates, whose `if` values guard imports (`CompilationConditions.importLines`).
// The lines are template text, not `print` output: Sourcery writes a template's `print` output above
// all of its text.
let importLines = CompilationConditions.importLines(
  imports: extractImports(),
  testable: extractImports(attributeName: "testable"),
  types: types.protocols.filter { $0.isAnnotated(any: importSelectors) })
-%>
<%_ for line in importLines { -%>
    <%_ %><%= line %>
<%_ } -%>
